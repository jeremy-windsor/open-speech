# ─────────────────────────────────────────────────────────────────────────────
# Open Speech — Configuration
#
# Naming convention:
#   OS_*   — Harness-level / shared settings
#   STT_*  — Speech-to-text specific
#   TTS_*  — Text-to-speech specific
#
# Old STT_API_KEY, STT_RATE_LIMIT, STT_CORS_ORIGINS etc. still work (backwards compat)
# but will log deprecation warnings. Migrate to OS_* names. Under Compose, OS_HOST, OS_PORT and
# OS_WYOMING_PORT (and the old STT_HOST and STT_PORT) are ignored: the container listens on
# 0.0.0.0:8100 and Wyoming on 10400, matching `ports:`. To publish other host ports, change the
# host side of `ports:` (for example "9000:8100").
# With a plain `docker run --env-file .env`, the image's own STT_MODEL, TTS_MODEL, TTS_VOICE and
# OS_MAX_LOADED_MODELS values win over STT_DEFAULT_MODEL, TTS_DEFAULT_MODEL, TTS_DEFAULT_VOICE and
# STT_MAX_LOADED_MODELS; use the new names there.
#
# Copy to .env and edit as needed. Values shown are source defaults unless a comment says otherwise;
# the Docker image and Compose files intentionally override some of them (see docs/CONFIGURATION.md).
# To set a value, remove the "# " in front of its NAME=value line. Each description sits on its own
# line above the setting: keep it that way and do not quote values, because `docker run --env-file`
# takes everything after '=' as the value, a trailing "# comment", blanks and quotes included.
# An empty value (NAME=) counts as unset, so the default applies. A value that isn't valid stops startup
# with an error naming the setting and the reason, never the value.
# Compose reads .env automatically; a source install needs `uv run --env-file .env ...`.
# A value holding a $, a double quote, a blank or a backslash is the exception to "do not quote":
# - Compose expands $NAME and ${NAME} in a value that isn't single-quoted: blank when NAME is unset
#   (Compose warns 'The "NAME" variable is not set'), so OS_API_KEY=$ecretKey123 reaches the server
#   empty, with auth off, and Xk9$mP2q arrives as Xk9.
# - `uv run --env-file` (a source install) expands a $ outside single quotes too, and there $$ is no
#   escape: Xk9$$mP2q arrives as Xk9. It also drops each double quote, so {"top_k":20} arrives as
#   {top_k:20}, and a blank or a backslash in a value that isn't quoted makes it stop reading .env at
#   that line, with only a warning: that setting and every one below it stay unset.
# Single-quote such a value: Compose and uv both take it as written, as in the key OS_API_KEY='Xk9$mP2q',
# the JSON OS_ASSISTANT_EXTRA_BODY='{"top_k": 20}' or the path TTS_PRONUNCIATION_DICT='C:\Users\me\dict.yaml'
# (a source install can also export it in the shell instead). Under Compose alone, $$ also writes a $.
# `docker run --env-file` expands nothing and keeps the $$ and the quotes as written, so one .env
# can't give such a value to it and to the other two: leave it unquoted there.
# An apostrophe (') is the other exception, and single quotes can't hold one: uv takes an unquoted '
#   as the start of a quote that runs to the next one, even lines below, so one ' makes it stop
#   reading .env there (OS_API_KEY=Xk9'mP2q leaves the key and OS_AUTH_REQUIRED below it unset, with
#   auth off) and two are dropped (it's-Bob's arrives as its-Bobs); OS_ASSISTANT_API_KEY is cut the
#   same way. For a source install write it as \' (OS_API_KEY=Xk9\'mP2q) or export it in the shell;
#   Compose and `docker run --env-file` read Xk9'mP2q as written but keep the backslash of \'.
#   Simplest is a key of letters, digits, - and _, such as one printed by
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ─────────────────────────────────────────────────────────────────────────────

# Compose image (:latest with the GPU override); use an immutable tag to deploy
# OPEN_SPEECH_IMAGE=jwindsor1/open-speech:cpu

# Git revision recorded by local image builds
# OPEN_SPEECH_REVISION=unknown

# Provider worker images (docker-compose.voice-models.yml; each worker starts only with its profile,
# see COMPOSE_PROFILES below)
# OPEN_SPEECH_CHATTERBOX_IMAGE=open-speech-chatterbox:0.2.1
# OPEN_SPEECH_QWEN3_IMAGE=open-speech-qwen3:0.3.0
# OPEN_SPEECH_FISH_IMAGE=open-speech-fish:0.1.0
# OPEN_SPEECH_BREEZE_IMAGE=open-speech-breeze:0.2.0

# ── Harness / transports ─────────────────────────────────────────────────────
# Bind address (ignored under Compose, which listens on 0.0.0.0)
# OS_HOST=0.0.0.0

# Listen port (ignored under Compose, which listens on 8100; change the host side of `ports:` instead)
# OS_PORT=8100

# ── SSL / HTTPS ──────────────────────────────────────────────────────────────
# Enable HTTPS with self-signed cert
# OS_SSL_ENABLED=true

# Path to SSL cert (empty = auto-generate)
# OS_SSL_CERTFILE=

# Path to SSL key (empty = auto-generate)
# OS_SSL_KEYFILE=

# Extra comma-separated DNS/IP SANs (for example: 192.0.2.24,openspeech.local)
# OS_TLS_EXTRA_SANS=

# A generated cert is renewed at startup once it expires within 30 days; your own cert files are never changed.
# Set OS_SSL_CERTFILE and OS_SSL_KEYFILE together: startup stops when only one of your two files exists.

# ── Security ─────────────────────────────────────────────────────────────────
# With OS_API_KEY set, requests need `Authorization: Bearer KEY`, except /health, /openapi.json (and
# /docs and /redoc when OS_API_DOCS=true), the web UI's own files and signed Reader audio links. A
# browser cannot send that header on a WebSocket: it calls POST /api/auth/ws-ticket with the key and
# connects with the returned ?ticket=, which works once, within 60 s. In the web UI, enter the key
# under Settings › Connection › API key; the browser keeps it and gets tickets itself. The old
# ?api_key= query parameter still works but is deprecated and logs a warning. A refused WebSocket is
# opened and then closed at once with a code and reason: 4001 a missing or wrong key or ticket, 1008 an
# Origin not allowed, 4004 the endpoint turned off (it used to fail the handshake with 403).

# API key (empty=auth disabled). Under Compose write a $ in it as $$, or single-quote it (see the top)
# OS_API_KEY=

# Fail startup when true and OS_API_KEY is empty
# OS_AUTH_REQUIRED=false

# Wrong API keys per IP within 60 s before that IP gets 429 for 60 s, even with the right key (0=off).
# Clients sharing one address (NAT, Docker Desktop, a proxy without OS_TRUST_PROXY) are locked out
# together: behind a proxy, see OS_TRUST_PROXY below; for NAT or Docker Desktop, 0 turns the lockout off
# OS_AUTH_FAILURE_LIMIT=10

# Requests/min per IP, WebSocket handshakes included (0=disabled)
# OS_RATE_LIMIT=0

# Burst allowance (0 = OS_RATE_LIMIT)
# OS_RATE_LIMIT_BURST=0

# Max upload size, enforced while the body arrives; also caps the audio of one Wyoming transcription.
# Compose also applies it to provider references
# OS_MAX_UPLOAD_MB=100

# Host check (DNS rebinding protection): an HTTP request or WebSocket handshake whose Host header is
# not allowed gets 400. Always allowed: IP addresses, dotless names (localhost, lan-box), *.localhost,
# *.local, *.lan, *.home.arpa, *.internal, and this machine's own hostname and FQDN (inside Docker,
# the container's, not the Docker host's).
# Other host names to serve, comma-separated: a public name used behind a proxy, router names such as
# *.fritz.box, *.localdomain or *.home ('*.example.com' matches its subdomains, '*' turns the check off)
# OS_ALLOWED_HOSTS=

# Empty = same-origin only; comma-separated origins (or '*') may call the API and send writes.
# A browser POST/PUT/PATCH/DELETE from any other origin gets 403
# OS_CORS_ORIGINS=

# Browser origins allowed on WebSockets besides this server's own ('*' = any); a page from any other
# origin gets its socket closed with 1008. Clients that send no Origin (SDK, Home Assistant, CLI) are
# always allowed
# OS_WS_ALLOWED_ORIGINS=

# nosniff, frame, referrer, opener and permissions (microphone=self) headers, and a strict CSP on the
# web UI; false turns them all off (needed to show the web UI in an iframe)
# OS_SECURITY_HEADERS=true

# true serves Swagger UI at /docs and ReDoc at /redoc. They load scripts from a CDN on this origin,
# where the web UI keeps its API key; the schema at /openapi.json is always served
# OS_API_DOCS=false

# Log level: DEBUG, INFO, WARNING or ERROR (any case); uvicorn's access log follows. DEBUG adds
# diagnostic lines, among them the text of /v1/audio/stream transcripts; chatty libraries such as
# httpx and websockets stay at INFO
# OS_LOG_LEVEL=INFO

# Take the client address (rate limits, lockout) from X-Forwarded-For. Only when clients cannot
# bypass the proxy: a client that connects directly can forge the header and so dodge the rate limit
# and the lockout
# OS_TRUST_PROXY=false

# Proxies in front of Open Speech that append to X-Forwarded-For; the client is the entry this many
# places from the right
# OS_TRUSTED_PROXY_HOPS=1

# Behind a reverse proxy, for example at https://speech.example.com:
#   - A proxy that passes the browser's Host through (nginx: proxy_set_header Host $host) needs that name
#     in OS_ALLOWED_HOSTS (speech.example.com). nginx's $host drops the port, so when the public URL has
#     a port other than 443 or 80, pass $http_host instead, or the same-origin match fails.
#   - A proxy that rewrites Host (nginx's default, $proxy_host) breaks the same-origin match: browser
#     writes get 403, and WebSockets close 1008, until the public origin (https://speech.example.com) is listed in
#     OS_CORS_ORIGINS and OS_WS_ALLOWED_ORIGINS.
#   - Make the proxy the only way in: the base Compose file publishes 8100 on every interface (for a
#     proxy on the same host, publish "127.0.0.1:8100:8100" instead). Then set OS_TRUST_PROXY=true, and
#     OS_TRUSTED_PROXY_HOPS to the number of proxies, so rate limits and the wrong-key lockout count
#     each client instead of the proxy's address.

# ── Persistence / Studio ─────────────────────────────────────────────────────
# Stored voice reference directory
# OS_VOICE_LIBRARY_PATH=/home/openspeech/data/voices

# Max stored voice refs (0=unlimited)
# OS_VOICE_LIBRARY_MAX_COUNT=100

# Max reference duration (0=unlimited)
# OS_VOICE_LIBRARY_MAX_SECONDS=60

# SQLite Studio metadata database
# OS_STUDIO_DB_PATH=/home/openspeech/data/studio.db

# Enable history logging
# OS_HISTORY_ENABLED=true

# Max retained history rows (0=unlimited); the only bound on history
# OS_HISTORY_MAX_ENTRIES=1000

# OS_HISTORY_RETAIN_AUDIO and OS_HISTORY_MAX_MB were removed: history never stored audio files.
# Setting either one only logs a startup warning that it is ignored.

# Enable effects processing
# OS_EFFECTS_ENABLED=true

# Conversation storage directory
# OS_CONVERSATIONS_DIR=/home/openspeech/data/conversations

# Composer storage directory
# OS_COMPOSER_DIR=/home/openspeech/data/composer

# ── Batch transcription ──────────────────────────────────────────────────────
# Concurrent batch jobs; one batch file is transcribed at a time
# OS_BATCH_WORKERS=2

# Max queued + running batch jobs
# OS_BATCH_MAX_PENDING=10

# Max aggregate upload size per batch request
# OS_BATCH_MAX_TOTAL_MB=500

# ── Wyoming Protocol (Home Assistant) ────────────────────────────────────────
# The Wyoming port has no authentication; OS_API_KEY does not apply to it.

# Enable Wyoming TCP server (Docker image/base Compose: true)
# OS_WYOMING_ENABLED=false

# Wyoming bind address (Docker image/base Compose: 0.0.0.0)
# OS_WYOMING_HOST=127.0.0.1

# Wyoming protocol port (ignored under Compose, which listens on 10400; change the host side of
# `ports:` instead)
# OS_WYOMING_PORT=10400

# Close a connection whose next event takes longer than N s to arrive, or that stops reading replies
# for N s (0=never)
# OS_WYOMING_IDLE_TIMEOUT_S=120

# Max open connections; at the cap a new one replaces the longest idle, or is closed while all are
# mid-request (0=unlimited)
# OS_WYOMING_MAX_CONNECTIONS=32

# ── Speech-to-Text (STT) ────────────────────────────────────────────────────
# Used when a request omits model or sends whisper-1 etc.; loaded on first use
# (Compose and both images: nvidia/parakeet-tdt-0.6b-v2, English only; set a Whisper model such as
# deepdml/faster-whisper-large-v3-turbo-ct2 for other languages)
# STT_MODEL=Systran/faster-whisper-base

# cpu or cuda
# STT_DEVICE=cpu

# int8, float16, int8_float16 (Whisper; Parakeet runs fp16 on a GPU and int8 on a CPU)
# STT_COMPUTE_TYPE=int8

# Optional local directory for downloaded STT models (empty = Hugging Face cache)
# STT_MODEL_DIR=

# Comma-separated models to load on startup, in the background once the server is up: it answers meanwhile, and a
# request for a model still loading waits for that load. A first Parakeet load on a GPU (download and fp16
# conversion) takes about 7 minutes.
# STT_PRELOAD_MODELS=

# Model /v1/audio/translations uses for whisper-1 or no model (empty = STT_MODEL). Parakeet, large-v3-turbo
# and English-only models (*.en, distil-*) can't translate and answer 400 translation_unsupported; set e.g.
# Systran/faster-whisper-medium (1.5 GB, downloaded on first translation) or -large-v3 (3 GB)
# STT_TRANSLATE_MODEL=

# Most GPU memory Parakeet's ONNX Runtime arena may take, in MB (0 = no cap). Past the card's memory,
# Windows pages the other loaded models out instead of failing, and their next request is seconds slower
# STT_PARAKEET_GPU_MEM_LIMIT_MB=2304

# ── Model Lifecycle (shared STT + TTS) ──────────────────────────────────────
# Seconds idle before auto-unload (0=never); pinned defaults stay loaded
# OS_MODEL_TTL=300

# Max loaded STT+TTS models, not counting pinned defaults (0=unlimited; Docker image/base Compose: 2)
# OS_MAX_LOADED_MODELS=0

# TTL and LRU eviction never unload STT_MODEL or TTS_MODEL; an explicit unload, or explicitly loading
# another model of the same type, still does
# OS_PIN_DEFAULT_MODELS=true

# GPU memory guard: check the GPU's free memory before each load onto it, unload idle models that
# aren't pinned to make room, and refuse a load that still doesn't fit (503 insufficient_gpu_memory)
# OS_GPU_MEMORY_GUARD=true

# GPU memory (MiB) kept free on top of a model's size, for the desktop and the CUDA libraries
# OS_GPU_HEADROOM_MB=600

# Big models (2 GiB or more) loaded at once besides the pinned defaults: auto takes it from the card
# (under 11 GiB: 1, under 22 GiB: 2, else no cap), a number sets it, 0 = no cap
# OS_GPU_MAX_BIG_MODELS=auto

# ── Streaming (WebSocket) ───────────────────────────────────────────────────
# Streaming audio chunk window in ms (base Compose uses 2000)
# OS_STREAM_CHUNK_MS=100

# Silence (ms) that ends an utterance; default for the endpointing query param
# OS_STREAM_ENDPOINTING_MS=300

# Max concurrent WebSocket streams
# OS_STREAM_MAX_CONNECTIONS=10

# Enable /v1/realtime WebSocket endpoint; false closes each socket with 4004 right after it opens
# OS_REALTIME_ENABLED=true

# Max realtime input buffer size per session
# OS_REALTIME_MAX_BUFFER_MB=50

# Close idle realtime sessions after N seconds
# OS_REALTIME_IDLE_TIMEOUT_S=120

# Talking over a reply this long stops it without waiting for the transcript
# OS_REALTIME_BARGE_IN_MAX_MS=1500

# With barge-in on, how far ahead of playback reply audio is sent (0=no limit)
# OS_REALTIME_AUDIO_LEAD_MS=1000

# ── AI assistant (your own OpenAI-compatible AI server) ─────────────────────
# Speech or typed questions over /v1/realtime (the web app's Talk view), Ask AI's texts and transcripts, or a
# Reader document, go to your AI server, and the reply is spoken or saved as a new document. It is off while
# OS_ASSISTANT_URL is empty and no URL is saved in Settings › AI assistant. Your words and your books go to
# that server: a cloud URL sends them out of your network. See docs/AI-ASSISTANT.md.
# For an AI agent of your own that only needs speech in and out, leave it off and see
# docs/AI-AGENTS.md.
#
# The connection (the URL, key, model, TLS check, template switch, token-field name, extra body and Stream
# replies below)
# starts here. Settings › AI assistant › Connection can change it without a restart, and saves it in
# assistant-connection.json next to OS_STUDIO_DB_PATH, the API key in plain text. No preset or session can
# change it. On a shared network set OS_API_KEY, or lock the connection here.

# true: the connection comes only from this file; Settings shows it read-only and can't change it
# OS_ASSISTANT_CONNECTION_LOCKED=false

# Base URL ending in /v1 (empty=off); /chat/completions and /models are appended to it. http or https only,
# with a valid host and port (not 192.168.1.300) and no user name, password, query or fragment, or startup
# stops; redirects aren't followed. For a server on the Docker host, use http://host.docker.internal:PORT/v1;
# for one on your network, http://ai-server.lan:8080/v1
# OS_ASSISTANT_URL=

# Sent as Authorization: Bearer KEY, only to the origin (scheme, host and port) of OS_ASSISTANT_URL; never
# logged or returned (empty=none). It is stripped (a trailing line break or tab is dropped) and must then be
# printable ASCII of up to 4096 characters, or startup stops. Under Compose write a $ in it as $$, or
# single-quote it (see the top)
# OS_ASSISTANT_API_KEY=

# Model name sent when a preset names none (empty=no model sent: the AI server picks)
# OS_ASSISTANT_MODEL=

# Check the AI server's TLS certificate; false for a server on your network with a self-signed one. The key
# above counts as set with this value: turning the check off in Settings for an https server withholds it
# until the key is given again there
# OS_ASSISTANT_VERIFY_TLS=true

# Also send the thinking controls as chat-template variables (chat_template_kwargs), for llama.cpp-style
# servers whose template reads enable_thinking and reasoning_effort; false for OpenAI's own API, which
# refuses the field
# OS_ASSISTANT_TEMPLATE_KWARGS=false

# Name the token limit is sent under: max_tokens, or max_completion_tokens for a server that refuses it
# OS_ASSISTANT_MAX_TOKENS_FIELD=max_tokens

# A JSON object merged into every request, for fields the presets don't cover; single-quote it, as in
# the line OS_ASSISTANT_EXTRA_BODY='{"top_k": 20}' (see the top). It can't set messages or stream, nests
# objects and lists at most 32 levels deep and holds no NaN or Infinity (anything else stops startup);
# its chat_template_kwargs are merged key by key (empty=none)
# OS_ASSISTANT_EXTRA_BODY=

# Stream replies: a voice turn asks with stream: true and speaks each sentence as soon as it arrives, so the
# voice starts before the AI has finished. false asks for the whole reply, for a server that can't stream (one that
# answers a streamed request with a plain JSON reply still works). Ask AI and book jobs never stream
# OS_ASSISTANT_STREAM=true

# Defaults for the AI presets, which Settings › AI assistant edits: a preset field left empty uses these.
# A realtime session.update or a book job can override a preset's fields for itself.

# System prompt of a voice turn whose preset leaves it empty (empty=the built-in voice prompt); book jobs
# fall back to the built-in book prompt instead
# OS_ASSISTANT_SYSTEM_PROMPT=

# Thinking switch: default sends nothing; on or off sends chat_template_kwargs.enable_thinking
# OS_ASSISTANT_THINKING=default

# reasoning_effort to send: none, minimal, low, medium, high or xhigh (empty=not sent). Use low for a
# server whose chat template thinks at length unless told, together with OS_ASSISTANT_TEMPLATE_KWARGS=true
# OS_ASSISTANT_REASONING_EFFORT=

# Thinking budget in tokens, sent as reasoning_budget_tokens: when the thinking reaches it, a server that reads
# the field (llama.cpp-style) closes the thinking and the model still writes a whole answer. Other servers ignore
# or refuse the field (0=not sent; at most 1000000)
# OS_ASSISTANT_THINKING_BUDGET=0

# Token limit of one reply, the thinking included on most servers (0=no limit sent; at most 32768). It is a
# hard cut-off the model isn't told about: an answer that reaches it stops mid-sentence. Ask for short answers
# in the prompt instead, and keep this as a safety net
# OS_ASSISTANT_MAX_TOKENS=0

# Sampling temperature, 0 to 2 (empty=not sent: the AI server's own default)
# OS_ASSISTANT_TEMPERATURE=

# Sampling top_p, 0 to 1 (empty=not sent: the AI server's own default)
# OS_ASSISTANT_TOP_P=

# Seconds to wait for the whole reply to a voice turn, 5 to 3600
# OS_ASSISTANT_TIMEOUT_S=120

# Seconds to wait for the reply to each piece of a book job, 5 to 3600
# OS_ASSISTANT_JOB_TIMEOUT_S=600

# Earlier exchanges sent with each voice turn, 0 to 100; a voice conversation starts fresh on a reconnect
# OS_ASSISTANT_HISTORY_TURNS=20

# Most book text sent in one request, 1000 to 200000 characters
# OS_ASSISTANT_CHUNK_CHARS=12000

# Send the AI's thinking to the client as text (it is never spoken)
# OS_ASSISTANT_SHOW_THINKING=true

# Speak a sentence when the AI can't answer a voice turn
# OS_ASSISTANT_SPEAK_ERRORS=true

# ── VAD (Voice Activity Detection) ──────────────────────────────────────────
# Enable VAD for /v1/audio/stream by default, and Wyoming's trimming of silence. Both keep the 300 ms
# before the first window over STT_VAD_THRESHOLD, as /v1/realtime's default prefix_padding_ms does
# STT_VAD_ENABLED=true

# Speech probability threshold (also used by streaming): speech starts at the first 32 ms window at or
# above it, and keeps the 300 ms before it
# STT_VAD_THRESHOLD=0.5

# Minimum speech duration Wyoming keeps (streaming ends speech after OS_STREAM_ENDPOINTING_MS)
# STT_VAD_MIN_SPEECH_MS=250

# Silence that ends a speech segment in Wyoming's trimming
# STT_VAD_SILENCE_MS=800

# ── Text-to-Speech (TTS) ────────────────────────────────────────────────────
# Enable/disable TTS endpoints
# TTS_ENABLED=true

# Used when /v1/audio/speech omits model or sends tts-1, tts-1-hd, gpt-4o-mini-tts
# TTS_MODEL=kokoro

# Used when voice is omitted and the model came from TTS_MODEL
# TTS_VOICE=af_heart

# Used when /v1/audio/speech omits speed
# TTS_SPEED=1.0

# cpu/cuda; empty inherits STT_DEVICE
# TTS_DEVICE=

# Max input characters per request; also Wyoming Synthesize text, the text of a realtime
# response.create, conversation turns and Ask AI's spoken reply. A model can have a lower limit of
# its own. An AI reply on /v1/realtime is spoken in segments, whatever its length
# TTS_MAX_INPUT_LENGTH=4096

# Comma-separated TTS models to load at startup
# TTS_PRELOAD_MODELS=

# Load TTS_MODEL in the background at startup when its provider is installed; it can download the
# weights on first start
# TTS_PRELOAD_DEFAULT=true

# JSON map of provider IDs to private worker URLs (set by docker-compose.voice-models.yml)
# TTS_EXTERNAL_PROVIDERS=

# Path to custom voice presets YAML. An entry the API would refuse is skipped with a warning that names
# the field, and is imported once the file is fixed
# TTS_VOICES_CONFIG=

# Used when /v1/audio/speech omits response_format
# TTS_DEFAULT_FORMAT=mp3

# Enable disk-backed TTS cache, shared by /v1/audio/speech and Wyoming
# TTS_CACHE_ENABLED=false

# Cache size limit in MB
# TTS_CACHE_MAX_MB=500

# Cache directory path
# TTS_CACHE_DIR=/var/lib/open-speech/cache

# Trim generated silence tail/head (part of the cache key)
# TTS_TRIM_SILENCE=true

# Peak-normalize output, except streamed responses (part of the cache key)
# TTS_NORMALIZE_OUTPUT=true

# Path to pronunciation dictionary file: YAML for .yaml or .yml, JSON otherwise, mapping text as written to
# the text to speak (AWS: A W S). Every key and value is read as the text written; an empty value removes
# the word, and a JSON null leaves its entry out
# TTS_PRONUNCIATION_DICT=

# Enable the incremental Live Reader WebSocket; false (or TTS_ENABLED=false) closes each socket with 4004
# right after it opens
# TTS_LIVE_ENABLED=true

# Concurrent Live Reader sessions per process
# TTS_LIVE_MAX_CONNECTIONS=1

# Close sessions idle for this many seconds
# TTS_LIVE_IDLE_TIMEOUT_S=300

# Max queued input characters per session
# TTS_LIVE_MAX_BUFFER_CHARS=8192

# Max synthesis segments waiting behind the active segment
# TTS_LIVE_MAX_PENDING_SEGMENTS=3

# Pause output after this much unconsumed audio
# TTS_LIVE_MAX_UNACKED_SECONDS=15

# Approximate PCM duration per audio delta
# TTS_LIVE_AUDIO_FRAME_MS=50

# Responsive/word-mode idle flush delay
# TTS_LIVE_SEGMENT_IDLE_MS=250

# Responsive/word-mode character cap
# TTS_LIVE_MAX_SEGMENT_CHARS=200

# Responsive/word-mode word cap
# TTS_LIVE_MAX_SEGMENT_WORDS=20

# Natural-mode incomplete-prose idle flush delay
# TTS_LIVE_SENTENCE_IDLE_MS=1500

# Natural-mode character cap; also for each segment of a spoken AI reply
# TTS_LIVE_SENTENCE_MAX_CHARS=500

# Natural-mode word cap; also for each segment of a spoken AI reply
# TTS_LIVE_SENTENCE_MAX_WORDS=80

# Maximum continuous client playback pause
# TTS_LIVE_MAX_PAUSE_S=900

# Close unpaused clients that stop acknowledging audio
# TTS_LIVE_PLAYBACK_STALL_TIMEOUT_S=30

# Maximum synchronous teardown wait
# TTS_LIVE_SHUTDOWN_TIMEOUT_S=5

# ── Reader (epub, text, Markdown and HTML read aloud) ───────────────────────
# Enable the Reader tab and /v1/reader API
# READER_ENABLED=true

# Rendered Reader audio (inside the ./data volume)
# READER_CACHE_DIR=/home/openspeech/data/reader

# Least recently played audio is removed above this size
# READER_CACHE_MAX_MB=2000

# Largest epub/text/HTML upload
# READER_MAX_UPLOAD_MB=50

# Largest imported document, in characters
# READER_MAX_DOCUMENT_CHARS=5000000

# Audio parts rendered ahead of the listener
# READER_LOOKAHEAD_PARTS=3

# Characters grouped into one audio part
# READER_PART_MAX_CHARS=450

# Lifetime of signed Reader audio links
# READER_MEDIA_URL_TTL_S=21600

# ── Voice provider workers (docker-compose.voice-models.yml) ────────────────
# The GPU workers are optional and off by default: each has a Compose profile of its own (chatterbox,
# qwen3, fish, breeze), and layering docker-compose.voice-models.yml starts only the workers named, with
# --profile qwen3 (--profile chatterbox, --profile fish, --profile breeze) on the command line, or
# listed here, comma-separated, e.g. COMPOSE_PROFILES=qwen3 or
# COMPOSE_PROFILES=qwen3,chatterbox. Docker Compose reads it, the same as --profile. Only Qwen3 Custom
# Voice has built-in voices; Chatterbox, Qwen3 Base, Fish Audio S2 and Breeze TTS 2 clone from a recording,
# and Breeze TTS 2 and Qwen3 VoiceDesign design a voice from a description.
# COMPOSE_PROFILES=

# Optional Hugging Face access token for gated model downloads (under Compose a $ in it is written $$)
# HF_TOKEN=

# Optional Qwen worker: before sm_80 fp32 for 0.6B and fp16 for 1.7B, bf16 on sm_80+
# QWEN3_DTYPE=auto

# Show the 0.6B and 1.7B Base cloning models; docker-compose.voice-models.yml defaults it to true
# QWEN3_ENABLE_BASE=false

# Script-weighted Qwen work per segment
# QWEN3_MAX_SEGMENT_UNITS=400

# Host-level Qwen generation ceiling
# QWEN3_MAX_NEW_TOKENS_CEILING=1200

# Cached reference prompts per Qwen worker
# QWEN3_PROMPT_CACHE_SIZE=8

# Qwen streaming queue timeout
# QWEN3_STREAM_QUEUE_TIMEOUT_S=30

# Chatterbox per-request text limit
# CHATTERBOX_MAX_INPUT_CHARS=350

# Restart the idle Chatterbox worker this long after an unload to free host RAM (0=never);
# docker-compose.voice-models.yml defaults it to 10
# CHATTERBOX_RESTART_AFTER_UNLOAD_S=0

# Cached reference conditionals per Chatterbox worker
# CHATTERBOX_REFERENCE_CACHE_SIZE=8

# Fish Audio S2 per-request text limit, and the most it speaks in one generation
# FISH_MAX_INPUT_CHARS=1500
# FISH_SEGMENT_CHARS=300

# Longest Fish Audio S2 reference recording, in seconds
# FISH_MAX_REFERENCE_SECONDS=30

# torch.compile the Fish model at load; false if the compile fails on your GPU (slower)
# FISH_COMPILE=true

# Fish context length in tokens (reference plus segment)
# FISH_MAX_SEQ_LEN=2048

# Cached encoded references per Fish worker
# FISH_REFERENCE_CACHE_SIZE=8

# Fish sampling, and its seed (the same for every segment, so a text keeps one voice)
# FISH_TEMPERATURE=0.7
# FISH_TOP_P=0.7
# FISH_SEED=42

# Restart the Fish worker this long after an unload or a failed load, since it can't free its model
# otherwise (0=never)
# FISH_RESTART_AFTER_UNLOAD_S=1

# Read by the Fish fork itself: token embeddings in host RAM, codec frames decoded at a time
# FISH_OFFLOAD_EMBEDDINGS=1
# FISH_DECODE_CHUNK_FRAMES=64

# Breeze TTS 2 per-request text limit (the port speaks longer text in pieces of whole sentences)
# BREEZE_MAX_INPUT_CHARS=4096

# Longest Breeze TTS 2 reference recording, in seconds
# BREEZE_MAX_REFERENCE_SECONDS=30

# Breeze guidance: a designed voice, a cloned one, and the least for text with a cue such as (laugh)
# BREEZE_DESIGN_CFG=3.0
# BREEZE_CLONE_CFG=1.0
# BREEZE_CUE_CFG=2.5

# Breeze sampling seed
# BREEZE_SEED=42

# Run Breeze's text encoder on the CPU: about 1 GB less GPU memory, slower
# BREEZE_TEXT_ENCODER_CPU=false

# ── STT post-processing ─────────────────────────────────────────────────────
# Enable diarization support
# STT_DIARIZE_ENABLED=false

# Apply denoising preprocessor
# STT_NOISE_REDUCE=false

# Normalize input audio
# STT_NORMALIZE=true
