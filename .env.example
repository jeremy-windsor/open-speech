# ─────────────────────────────────────────────────────────────────────────────
# Open Speech — Configuration
#
# Naming convention:
#   OS_*   — Harness-level / shared settings
#   STT_*  — Speech-to-text specific
#   TTS_*  — Text-to-speech specific
#
# Old STT_PORT, STT_HOST, STT_API_KEY etc. still work (backwards compat)
# but will log deprecation warnings. Migrate to OS_* names.
#
# Copy to .env and edit as needed. Values shown are source defaults unless a comment says otherwise;
# Compose files may intentionally override launch defaults.
# ─────────────────────────────────────────────────────────────────────────────

# ── Harness / transports ─────────────────────────────────────────────────────
# OS_HOST=0.0.0.0                                          # Bind address
# OS_PORT=8100                                             # Listen port

# ── SSL / HTTPS ──────────────────────────────────────────────────────────────
# OS_SSL_ENABLED=true                                      # Enable HTTPS with self-signed cert
# OS_SSL_CERTFILE=                                         # Path to SSL cert (empty = auto-generate)
# OS_SSL_KEYFILE=                                          # Path to SSL key (empty = auto-generate)
# OS_TLS_EXTRA_SANS=                                       # Extra comma-separated DNS/IP SANs (for example: 192.0.2.24,openspeech.local)

# ── Security ─────────────────────────────────────────────────────────────────
# The bundled web UI cannot currently attach an API key; use an authenticated external client when set.
# OS_API_KEY=                                              # API key (empty=auth disabled)
# OS_AUTH_REQUIRED=false                                   # Fail startup when true and OS_API_KEY is empty
# OS_RATE_LIMIT=0                                          # Requests/min per IP (0=disabled)
# OS_RATE_LIMIT_BURST=0                                    # Burst allowance
# OS_MAX_UPLOAD_MB=100                                     # Max upload size; Compose also applies it to provider references
# OS_CORS_ORIGINS=*                                        # Comma-separated CORS origins
# OS_TRUST_PROXY=false                                     # Trust X-Forwarded-For headers
# OS_WS_ALLOWED_ORIGINS=                                    # Comma-separated allowed WS Origin values

# ── Persistence / Studio ─────────────────────────────────────────────────────
# OS_VOICE_LIBRARY_PATH=/home/openspeech/data/voices       # Stored voice reference directory
# OS_VOICE_LIBRARY_MAX_COUNT=100                           # Max stored voice refs (0=unlimited)
# OS_VOICE_LIBRARY_MAX_SECONDS=60                          # Max reference duration (0=unlimited)
# OS_STUDIO_DB_PATH=/home/openspeech/data/studio.db        # SQLite Studio metadata database
# OS_HISTORY_ENABLED=true                                  # Enable history logging
# OS_HISTORY_MAX_ENTRIES=1000                              # Max retained history rows
# OS_HISTORY_RETAIN_AUDIO=true                             # Retain output-path metadata where available
# OS_HISTORY_MAX_MB=2000                                   # Audio/history storage budget in MB
# OS_EFFECTS_ENABLED=true                                  # Enable effects processing
# OS_CONVERSATIONS_DIR=/home/openspeech/data/conversations # Conversation storage directory
# OS_COMPOSER_DIR=/home/openspeech/data/composer           # Composer storage directory
# OS_PROVIDERS_DIR=/home/openspeech/data/providers         # Persistent provider install directory

# ── Batch transcription ──────────────────────────────────────────────────────
# OS_BATCH_WORKERS=2                                       # Concurrent batch worker count
# OS_BATCH_MAX_PENDING=10                                  # Max queued + running batch jobs
# OS_BATCH_MAX_TOTAL_MB=500                                # Max aggregate upload size per batch request

# ── Wyoming Protocol (Home Assistant) ────────────────────────────────────────
# OS_WYOMING_ENABLED=false                                 # Enable Wyoming TCP server
# OS_WYOMING_HOST=127.0.0.1                                # Wyoming bind address
# OS_WYOMING_PORT=10400                                    # Wyoming protocol port

# ── Speech-to-Text (STT) ────────────────────────────────────────────────────
# STT_MODEL=Systran/faster-whisper-base                    # Default STT model
# STT_DEVICE=cpu                                           # cpu or cuda
# STT_COMPUTE_TYPE=int8                                    # int8, float16, int8_float16
# STT_MODEL_DIR=                                           # Optional local directory for downloaded STT models
# STT_PRELOAD_MODELS=                                      # Comma-separated models to load on startup

# ── Model Lifecycle (shared STT + TTS) ──────────────────────────────────────
# OS_MODEL_TTL=300                                         # Seconds idle before auto-unload, including default models (0=never)
# OS_MAX_LOADED_MODELS=0                                   # Max STT+TTS models in memory (0=unlimited)

# ── Streaming (WebSocket) ───────────────────────────────────────────────────
# OS_STREAM_CHUNK_MS=100                                   # Streaming audio chunk window in ms (base Compose uses 2000)
# OS_STREAM_VAD_THRESHOLD=0.5                              # Voice activity detection threshold
# OS_STREAM_ENDPOINTING_MS=300                             # Silence before finalizing utterance
# OS_STREAM_MAX_CONNECTIONS=10                             # Max concurrent WebSocket streams
# OS_REALTIME_ENABLED=true                                 # Enable /v1/realtime WebSocket endpoint
# OS_REALTIME_MAX_BUFFER_MB=50                             # Max realtime input buffer size per session
# OS_REALTIME_IDLE_TIMEOUT_S=120                           # Close idle realtime sessions after N seconds

# ── VAD (Voice Activity Detection) ──────────────────────────────────────────
# STT_VAD_ENABLED=true                                     # Enable VAD for /v1/audio/stream by default
# STT_VAD_THRESHOLD=0.5                                    # Speech probability threshold
# STT_VAD_MIN_SPEECH_MS=250                                # Minimum speech duration before activation
# STT_VAD_SILENCE_MS=800                                   # Silence required before endpointing

# ── Text-to-Speech (TTS) ────────────────────────────────────────────────────
# TTS_ENABLED=true                                         # Enable/disable TTS endpoints
# TTS_MODEL=kokoro                                         # Default TTS engine
# TTS_VOICE=af_heart                                       # Default voice
# TTS_SPEED=1.0                                            # Default speech speed
# TTS_DEVICE=                                              # cpu/cuda; empty inherits STT_DEVICE
# TTS_MAX_INPUT_LENGTH=4096                                # Max input text characters
# TTS_PRELOAD_MODELS=                                      # Comma-separated TTS models to preload
# TTS_EXTERNAL_PROVIDERS=                                  # JSON map of provider IDs to private worker URLs
# TTS_VOICES_CONFIG=                                       # Path to custom voice presets YAML
# TTS_DEFAULT_FORMAT=mp3                                   # Default audio format for /v1/audio/speech
# TTS_CACHE_ENABLED=false                                  # Enable disk-backed TTS cache
# TTS_CACHE_MAX_MB=500                                     # Cache size limit in MB
# TTS_CACHE_DIR=/var/lib/open-speech/cache                # Cache directory path
# TTS_TRIM_SILENCE=true                                    # Trim generated silence tail/head
# TTS_NORMALIZE_OUTPUT=true                                # Normalize output loudness
# TTS_PRONUNCIATION_DICT=                                  # Path to pronunciation dictionary file
# TTS_LIVE_ENABLED=true                                    # Enable the incremental Live Reader WebSocket
# TTS_LIVE_MAX_CONNECTIONS=1                               # Concurrent Live Reader sessions per process
# TTS_LIVE_IDLE_TIMEOUT_S=300                              # Close sessions idle for this many seconds
# TTS_LIVE_MAX_BUFFER_CHARS=8192                           # Max queued input characters per session
# TTS_LIVE_MAX_PENDING_SEGMENTS=3                          # Max synthesis segments waiting behind the active segment
# TTS_LIVE_MAX_UNACKED_SECONDS=15                          # Pause output after this much unconsumed audio
# TTS_LIVE_AUDIO_FRAME_MS=50                               # Approximate PCM duration per audio delta
# TTS_LIVE_SEGMENT_IDLE_MS=250                             # Responsive/word-mode idle flush delay
# TTS_LIVE_MAX_SEGMENT_CHARS=200                           # Responsive/word-mode character cap
# TTS_LIVE_MAX_SEGMENT_WORDS=20                            # Responsive/word-mode word cap
# TTS_LIVE_SENTENCE_IDLE_MS=1500                           # Natural-mode incomplete-prose idle flush delay
# TTS_LIVE_SENTENCE_MAX_CHARS=500                          # Natural-mode character cap
# TTS_LIVE_SENTENCE_MAX_WORDS=80                           # Natural-mode word cap
# TTS_LIVE_MAX_PAUSE_S=900                                 # Maximum continuous client playback pause
# TTS_LIVE_PLAYBACK_STALL_TIMEOUT_S=30                     # Close unpaused clients that stop acknowledging audio
# TTS_LIVE_SHUTDOWN_TIMEOUT_S=5                            # Maximum synchronous teardown wait
# HF_TOKEN=                                                # Optional Hugging Face access token for gated model downloads
# QWEN3_DTYPE=auto                                         # Optional Qwen worker: fp32 before sm_80, bf16 on sm_80+
# QWEN3_ENABLE_BASE=false                                  # Opt in to experimental 0.6B Base cloning; hidden by default
# QWEN3_MAX_SEGMENT_UNITS=400                              # Script-weighted Qwen work per segment
# QWEN3_MAX_NEW_TOKENS_CEILING=1200                       # Host-level Qwen generation ceiling
# QWEN3_PROMPT_CACHE_SIZE=8                                # Cached reference prompts per Qwen worker
# QWEN3_STREAM_QUEUE_TIMEOUT_S=30                          # Qwen streaming queue timeout
# CHATTERBOX_MAX_INPUT_CHARS=350                           # Chatterbox per-request text limit
# COSYVOICE_MAX_INPUT_CHARS=1500                           # CosyVoice per-request text limit
# COSYVOICE_FP16=true                                      # CosyVoice CUDA precision on the worker
# ── STT post-processing ─────────────────────────────────────────────────────
# STT_DIARIZE_ENABLED=false                                # Enable diarization support
# STT_NOISE_REDUCE=false                                   # Apply denoising preprocessor
# STT_NORMALIZE=true                                       # Normalize input audio
